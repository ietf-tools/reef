# Copy to .env and fill in. docker compose reads this file automatically.
# These are the values that differ per developer or deployment; everything else
# has a sensible default in the settings and compose files.

# Authentik OIDC application (account.ietf.org).
# The confidential client used by the Django builder/analytics site:
REEF_OIDC_RP_CLIENT_ID=
REEF_OIDC_RP_CLIENT_SECRET=
# The public (PKCE) client used by the Nuxt survey runner:
NUXT_PUBLIC_OIDC_CLIENT_ID=

# Which callers this API accepts access tokens from, as a resource server. This
# is separate from the login settings above: every Authentik application that
# calls the API has its own issuer, JWKS and client id, and being able to log
# into Reef's own site says nothing about being allowed to call the API.
#
# Comma-separated Authentik application slugs whose tokens are accepted. Include
# "reef" for the survey runner and "rfc-editor" for Red. Defaults to "reef".
REEF_API_OIDC_APP_SLUGS=reef,rfc-editor
# Comma-separated client ids accepted in the `aud` claim — one per caller above,
# since Authentik sets `aud` to the client id the token was issued to. These are
# public client ids, not secrets. Defaults to REEF_OIDC_RP_CLIENT_ID.
REEF_API_OIDC_AUDIENCES=
# Comma-separated signature algorithms accepted from those callers. Authentik
# picks the signing key per application, so this varies by caller: rfc-editor
# signs with ES256. Defaults to "RS256,ES256". Symmetric algorithms (HS*) are
# always refused, whatever is set here.
REEF_API_OIDC_ALGORITHMS=

# Comma-separated Authentik groups whose members get staff (builder/analytics)
# access. Leave empty and use the local break-glass superuser instead.
REEF_OIDC_STAFF_GROUPS=

# SurveyJS commercial license key for Creator and Analytics. Leave empty in
# development (the bundles run with a watermark).
REEF_SURVEYJS_LICENSE_KEY=

# Precomputer blob store. `manage.py precompute` renders the public API
# responses ahead of time and writes them here. Leave the bucket empty and it
# writes to ./precomputed instead, which is the development default and needs
# no credentials. REEF_PRECOMPUTE_S3_ENDPOINT is for S3-compatible services;
# leave it empty for AWS.
REEF_PRECOMPUTE_S3_BUCKET=
REEF_PRECOMPUTE_S3_ENDPOINT=
REEF_PRECOMPUTE_S3_ACCESS_KEY_ID=
REEF_PRECOMPUTE_S3_SECRET_ACCESS_KEY=

# Where a notification tells its reader to go to change or stop it: a page on Red,
# which owns the subscription UI. Leave empty in development; production refuses to
# send digests without it.
REEF_SUBSCRIPTIONS_URL=
