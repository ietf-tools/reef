# Copy to .env and fill in. docker compose reads this file automatically.
# These are the values that differ per developer or deployment; everything else
# has a sensible default in the settings and compose files.

# Authentik OIDC applications (account.ietf.org).
#
# The confidential client Reef itself logs into Authentik with, for the Django
# admin and the builder/analytics site (/manage/) — the only interactive login
# Reef performs. A separate "reef-admin-staging" application
# (REEF_ADMIN_OIDC_APP_SLUG below), not the survey-taking one: public
# survey-takers never log into Reef directly, see REEF_API_OIDC_APP_SLUGS below.
REEF_ADMIN_OIDC_APP_SLUG=reef-admin-staging
REEF_ADMIN_OIDC_RP_CLIENT_ID=
REEF_ADMIN_OIDC_RP_CLIENT_SECRET=
# The public (PKCE) client the Nuxt survey runner uses to authenticate a
# survey-taker against Reef's own "reef-staging" application — same
# account.ietf.org identity Red's site knows, separate registered app, and
# entirely client-side: Reef's server is never a party to this login. Neither
# is a secret, and both default in nuxt.config.ts. The runner is a static
# bundle, so these apply when it is built or served by `nuxt dev`, not at
# runtime. The authority's slug must be one of REEF_API_OIDC_APP_SLUGS below.
NUXT_PUBLIC_OIDC_AUTHORITY=https://account.ietf.org/application/o/reef-staging/
NUXT_PUBLIC_OIDC_CLIENT_ID=dAytIOu6rzN2Za3kyeFlo3FhHh3K0al0w0k1N649

# Which callers this API accepts access tokens from, as a resource server. This
# is separate from the login settings above: every Authentik application that
# calls the API has its own issuer, JWKS and client id, and being able to log
# into Reef's own admin says nothing about being allowed to call the API.
#
# Comma-separated Authentik application slugs whose tokens are accepted: two
# callers today — "rfc-editor" (Red itself) and "reef-staging" (survey-takers
# authenticated via the Nuxt runner's PKCE client above), which is also the
# default. Leaving "reef-staging" out rejects every signed-in survey-taker.
REEF_API_OIDC_APP_SLUGS=rfc-editor,reef-staging
# Comma-separated client ids accepted in the `aud` claim — one per caller above,
# since Authentik sets `aud` to the client id the token was issued to. These are
# public client ids, not secrets. No default: an empty list disables audience
# verification, so every real deployment must set this: Red's client id, then
# the Nuxt runner's NUXT_PUBLIC_OIDC_CLIENT_ID value.
REEF_API_OIDC_AUDIENCES=xkIC1bO4M3FaEoUrMyEQhMDvv46zAhba0XKYS64L,dAytIOu6rzN2Za3kyeFlo3FhHh3K0al0w0k1N649

# Comma-separated signature algorithms accepted from those callers. Authentik
# picks the signing key per application, so this varies by caller: rfc-editor
# signs with ES256. Defaults to "RS256,ES256". Symmetric algorithms (HS*) are
# always refused, whatever is set here.
REEF_API_OIDC_ALGORITHMS=

# Comma-separated Authentik groups whose members get staff access when they log
# into the admin/builder site. A bearer token grants neither staff nor
# superuser, whatever groups it carries. Staff alone reach the builder and
# analytics but see no models in the Django admin, which needs
# REEF_OIDC_SUPERUSER_GROUPS below. Leave empty and use the local break-glass
# superuser for admin access instead.
REEF_OIDC_STAFF_GROUPS=team-dev,team-staff
# Comma-separated Authentik groups whose members get full superuser access via
# OIDC (implies staff, regardless of REEF_OIDC_STAFF_GROUPS above). Leave empty
# and use the local break-glass superuser for that instead — this only grants
# it more broadly, by group, once an operator opts one in.
REEF_OIDC_SUPERUSER_GROUPS=

# SurveyJS commercial license key for Creator and Analytics. Leave empty in
# development (the bundles run with a watermark).
REEF_SURVEYJS_LICENSE_KEY=

# Precomputer blob store. `manage.py precompute` renders the public API
# responses ahead of time and writes them here. Leave the bucket empty and it
# writes to ./precomputed instead, which is the development default and needs
# no credentials. REEF_PRECOMPUTE_S3_ENDPOINT is for S3-compatible services;
# leave it empty for AWS.
REEF_PRECOMPUTE_S3_BUCKET=
REEF_PRECOMPUTE_S3_ENDPOINT=
REEF_PRECOMPUTE_S3_ACCESS_KEY_ID=
REEF_PRECOMPUTE_S3_SECRET_ACCESS_KEY=

# Where a notification tells its reader to go to change or stop it: a page on Red,
# which owns the subscription UI. Leave empty in development; production refuses to
# send digests without it.
REEF_SUBSCRIPTIONS_URL=
