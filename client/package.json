{
  "name": "reef-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run gen:api",
    "gen:api": "openapi-typescript ../reef_api.yaml -o app/types/reef-api.ts",
    "typecheck": "nuxt typecheck",
    "test:lint": "oxlint",
    "test:lint:fix": "oxlint --fix",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/core": "^14.3.0",
    "nuxt": "^4.0.0",
    "oidc-client-ts": "^3.1.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.0.0",
    "survey-core": "^2.0.0",
    "survey-vue3-ui": "^2.0.0",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.4.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0"
  }
}
