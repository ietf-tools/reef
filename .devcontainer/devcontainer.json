// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "Reef",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.extend.yml",
    "docker-compose.extend-custom.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8088],
  "portsAttributes": {
    "8001": {
      "label": "Django",
      "onAutoForward": "ignore"
    },
    "3001": {
      "label": "Nuxt",
      "onAutoForward": "ignore"
    },
    // Nuxt should never be here, but get-port-please falls back to the
    // 3000-3100 range if 3001 is taken. Don't forward it to the host, where
    // it would collide with Red.
    "3000": {
      "label": "Nuxt (stray)",
      "onAutoForward": "ignore"
    },
    "8088": {
      "label": "NGINX",
      "onAutoForward": "notify"
    }
  },
  "shutdownAction": "stopCompose",
  // Create the custom compose file before Docker Compose runs
  "initializeCommand": "[ -f .devcontainer/docker-compose.extend-custom.yml ] || touch .devcontainer/docker-compose.extend-custom.yml",
  "postCreateCommand": "/docker-init.sh",
  "postStartCommand": "/docker-start.sh",
  "containerEnv": {
    "EDITOR_VSCODE": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django",
        "Vue.volar",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.languageServer": "Default"
      }
    }
  },
  "remoteUser": "dev"
}
