{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "createdOn": {
      "type": "string"
    },
    "index": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "object",
            "properties": {
              "slug": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["slug", "name"]
          },
          "stream": {
            "type": "object",
            "properties": {
              "slug": { "type": "string" },
              "name": { "type": "string" }
            }
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "titlepage_name": { "type": "string" }
              }
            }
          },
          "published": {
            "type": "string"
          },
          "area": {
            "type": "object",
            "properties": {
              "acronym": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["acronym", "name"]
          },
          "group": {
            "type": "object",
            "properties": {
              "acronym": { "type": "string" },
              "name": { "type": "string" }
            },
            "required": ["acronym", "name"]
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pages": {
            "type": "number"
          },
          "abstract": {
            "type": "string"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "value": { "type": "string" }
              },
              "required": ["type", "value"]
            }
          },
          "obsoletes": { "$ref": "#/$defs/relation" },
          "obsoleted_by": { "$ref": "#/$defs/relation" },
          "updates": { "$ref": "#/$defs/relation" },
          "updated_by": { "$ref": "#/$defs/relation" },
          "subseries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "number": { "type": "number" }
              }
            }
          }
        },
        "required": ["number", "title", "status"]
      }
    }
  },
  "required": ["createdOn", "index"],
  "$defs": {
    "relation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": { "type": "number" }
        }
      }
    }
  }
}
