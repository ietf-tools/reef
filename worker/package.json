{
  "name": "reef-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --env staging",
    "dev": "wrangler dev --env staging",
    "cf-typegen": "wrangler types --env staging",
    "test": "npm run test:unittests && npm run test:types",
    "test:unittests": "vitest run",
    "test:unittests:watch": "vitest",
    "test:types": "tsc --noEmit",
    "format": "oxfmt ."
  },
  "dependencies": {
    "itty-router": "^5.0.24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
